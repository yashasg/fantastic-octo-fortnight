# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Xcode / Swift Package Manager
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.xcscmblueprint

# Swift build artifacts
.build/
.swiftpm/

# macOS
.DS_Store
.AppleDouble
.LSOverride
*.xcresult/

# XcodeGen-generated UITest project (generated from UITests/project.yml)
UITests/*.xcodeproj/
UITests/*.xcworkspace/

# XcodeGen-generated Screen Time extensions project (generated from project.yml)
# Generated to ScreenTimeExtensions/ by scripts/setup-screentime.sh.
ScreenTimeExtensions/*.xcodeproj/
ScreenTimeExtensions/*.xcworkspace/

# Dev artifacts (screenshots, issue dumps, preview files, tool logs)
*.png
*.jpeg
*-issues.json
uitest_run.log
excalidraw.log
